# Impresoras térmicas USB (usblp → /dev/usb/lp*)
# TAG+uaccess: acceso al usuario de la sesión activa (Ubuntu/desktop).
# MODE 0666: acceso directo en puestos dedicados sin depender solo del grupo lp.
SUBSYSTEM=="usbmisc", KERNEL=="lp[0-9]*", TAG+="uaccess", MODE="0666"
SUBSYSTEM=="usb", KERNEL=="lp[0-9]*", TAG+="uaccess", MODE="0666"
